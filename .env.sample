OPENAI_API_KEY=your-openai-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# Full name on your Venmo account exactly as it appears in the "To" column of
# Venmo's exported CSV. Used by categorize_transactions.py to identify which
# side of each Venmo transaction is the other party.
VENMO_ACCOUNT_HOLDER_NAME=Firstname Lastname

# Google Sheets spreadsheet ID for the transaction archive
CURRENT_YEAR_ARCHIVE_SHEET_ID=your-google-sheet-id-this-year
PAST_YEAR_ARCHIVE_SHEET_ID=your-google-sheet-id-last-year